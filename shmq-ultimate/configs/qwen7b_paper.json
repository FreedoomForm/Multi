{
  "model_name": "Qwen/Qwen2.5-7B-Instruct",
  "device": "cuda",
  "dtype": "float16",
  "n_samples": 128,
  "sequence_length": 2048,
  "batch_size": 4,
  "group_size": 128,
  "smooth_alpha": 0.5,
  "smooth_scale_min": 0.0,
  "target_hp_ratio": 0.20,
  "base_hp_ratio": 0.125,
  "inter_layer_hessian": "fisher",
  "dampening": 0.1,
  "use_mean_diag_dampening": true,
  "enable_autoround": true,
  "autoround_iters": 200,
  "autoround_lr": 5e-4,
  "enable_sqc": true,
  "sqc_zscore_threshold": 3.0,
  "sqc_scale_range": [0.9, 1.1],
  "sqc_scale_search_points": 11,
  "sqc_salience_lambda": 0.1,
  "gptq_percdamp": 0.01,
  "gptq_block_size": 128,
  "activation_bits": 8,
  "ilp_solver": "PULP_CBC_CMD",
  "ilp_time_limit": 60,
  "excluded_layer_keywords": ["lm_head", "embed"],
  "intra_layer_hp_ratio": 0.125
}
