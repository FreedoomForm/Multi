{
  "model_name": "Qwen/Qwen2.5-7B-Instruct",
  "bit_percent": {"8": 10, "4": 90},
  "group_size": 128,
  "activation_bit_width": 8,
  "weight_4bit_asymmetric": true,
  "weight_8bit_asymmetric": false,
  "gptq_4bit": true,
  "gptq_8bit": true,
  "clip_shrink_4bit": true,
  "clip_shrink_8bit": true,
  "gptq_group_reorder": true,

  "calib_dataset": "wikitext2",
  "n_samples": 128,
  "seed": 0,
  "sequence_length": 2048,

  "enable_permutation": true,
  "enable_rmsnorm_fusion": true,
  "enable_parallel_constraint": true,
  "enable_smoothquant": true,
  "enable_autoround": true,
  "intra_hessian_lambda": 0.1,
  "hp_ratio": 0.10,
  "autoround_iters": 200,
  "autoround_lr": 0.001,
  "autoround_block_size": 128,

  "smoothquant_alpha": 0.5,

  "device": "cuda",
  "dtype": "float16",
  "save_dir": "./quantized_models/qwen7b_shmq_v2",

  "eval_ppl": true,
  "eval_ppl_dataset": "wikitext2",
  "eval_zeroshot": false
}
